# Copy to .env.local (npm run setup does this) and fill in. Never commit .env.local.
# Vars marked [gateway] go to Vercel with `npm run sync-vercel-env`.
# Vars marked [local] are only used by `npm run provision` and never leave your machine.

# ---- Gateway core ----
# [gateway] Signs and verifies bearer tokens. At least 32 characters. `npm run setup` generates it.
# Rotating it revokes every token at once.
WEBHOOK_SIGNING_SECRET=
# [gateway] Optional: comma-separated token ids to reject (printed as "Token id" by provision).
REVOKED_TOKEN_IDS=
# [local] Your deployed endpoint, printed next to each token: the project domain Vercel shows as
# "Aliased" after deploy, such as https://<your-project>.vercel.app/api/webhook
WEBHOOK_URL=

# ---- Airtable connector ----
# [gateway] Personal access token with data.records:read and data.records:write,
# limited to the workspace of your bases. https://airtable.com/create/tokens
AIRTABLE_PAT=
# [local] Personal access token with schema.bases:read and schema.bases:write, limited to the same workspace.
AIRTABLE_PROVISION_PAT=
# [local] Workspace id (wsp...) where new bases are created. It is in the workspace URL.
AIRTABLE_WORKSPACE_ID=

# ---- GitHub Issues connector ----
# [gateway] Fine-grained personal access token limited to the destination repositories ("Only select
# repositories"), with the "Issues" repository permission set to "Read and write". Also used by
# `npm run provision`. https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# ---- n8n connector ----
# [gateway] Your n8n instance URL, such as https://n8n.example.com (https only; no /webhook, query or credentials).
# Reports go to <N8N_BASE_URL>/webhook/<path>, the production URL of a published Webhook node.
N8N_BASE_URL=
# [gateway] Optional: sent as the X-Webhook-Secret header. Require it with Header Auth on the Webhook node.
N8N_WEBHOOK_SECRET=

# ---- Zapier and Make connectors ----
# No settings: the webhook id travels in the token. See connectors/zapier and connectors/make.
